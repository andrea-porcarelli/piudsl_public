    email admin@piudsl.it
}

# In produzione: CADDY_DOMAIN=www.piudsl.it (impostato in .env, letto dal docker-compose).
# Caddy gestisce ACME automatico (Let's Encrypt HTTP-01 sulla 80) e redirect HTTP -> HTTPS.
# Prerequisiti: DNS A/AAAA puntato a questo host + porte 80 e 443 aperte verso internet.
{$CADDY_DOMAIN} {
    encode zstd gzip

    reverse_proxy piudsl_app_panel:8000

    # I manifest PWA richiedono MIME application/manifest+json
    header /manifest.webmanifest        Content-Type "application/manifest+json"
    header /manifest-public.webmanifest Content-Type "application/manifest+json"
}
